#!/usr/bin/env python3
"""PROTOTYPE, throwaway. Run write-script over every Response in both modes, silently, then print a table.

usage: run-all [--tag rev1] [--model haiku] [--only 04] [--jobs 4]
"""
import argparse, json, pathlib, subprocess, sys
from concurrent.futures import ThreadPoolExecutor

HERE = pathlib.Path(__file__).resolve().parent.parent
WS = HERE / "bin" / "write-script"

ap = argparse.ArgumentParser()
ap.add_argument("--tag", default="")
ap.add_argument("--model", default="haiku")
ap.add_argument("--only", default="", help="substring of the Response file name")
ap.add_argument("--jobs", type=int, default=4)
ap.add_argument("--cap-words", type=int, default=680)
ap.add_argument("--chunk", action="store_true", help="pass --chunk to write-script (mechanical paragraph sizing)")
a = ap.parse_args()

responses = sorted(p for p in (HERE / "responses").glob("*.md") if a.only in p.name)
jobs = []
for r in responses:
    jobs.append([str(WS), str(r), "--quiet", "--model", a.model, "--cap-words", str(a.cap_words)]
                + (["--tag", a.tag] if a.tag else []) + (["--chunk"] if a.chunk else []))
    if len(r.read_text().split()) <= a.cap_words:  # a capped full run already is the brief run
        jobs.append(jobs[-1] + ["--brief"])

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

with ThreadPoolExecutor(a.jobs) as ex:
    for res in ex.map(run, jobs):
        if res.returncode:
            print(res.stderr, file=sys.stderr)

# Table of this batch (the last len(jobs) lines of runs.jsonl carry our tag)
rows = [json.loads(l) for l in (HERE / "results" / "runs.jsonl").read_text().splitlines()]
rows = [r for r in rows if r["tag"] == a.tag and r["model"] == a.model][-len(jobs):]
print(f"{'response':24} {'mode':6} {'resp':>5} {'script':>6} {'ratio':>5} {'~sec':>4} {'1st':>4} {'paras':28} {'t1st':>5} {'done':>5} flags")
for r in sorted(rows, key=lambda r: (r["name"], r["mode"])):
    print(f"{r['name']:24} {r['mode'] + ('*' if r['capped'] else ''):6} {r['response_words']:5} {r['script_words']:6} {r['ratio']:5} {r['est_seconds']:4} "
          f"{(r['paragraphs'] or [0])[0]:4} {str(r['paragraphs'][1:]):28} {r['t_first_paragraph']:5} {r['t_done']:5} {' '.join(r['flags']) or '-'}")
print("* = brief forced by the duration cap; '1st' is the opening paragraph's words; 'paras' the rest")
