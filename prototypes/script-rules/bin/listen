#!/usr/bin/env python3
"""PROTOTYPE, throwaway. Speak a saved Script paragraph by paragraph with macOS say. Ctrl-C stops.

usage: listen results/04-code-explanation.full.txt [--voice Samantha] [--rate 190] [--from 3]
"""
import argparse, pathlib, subprocess, sys

ap = argparse.ArgumentParser()
ap.add_argument("script")
ap.add_argument("--voice", default="Samantha")
ap.add_argument("--rate", type=int, default=190)
ap.add_argument("--from", dest="start", type=int, default=1, help="1-based paragraph to start at")
a = ap.parse_args()

paras = [p.strip() for p in pathlib.Path(a.script).read_text().split("\n\n") if p.strip()]
try:
    for i, p in enumerate(paras, 1):
        if i < a.start:
            continue
        print(f"[{i}/{len(paras)}, {len(p.split())}w] {p}\n", flush=True)
        subprocess.run(["say", "-v", a.voice, "-r", str(a.rate)], input=p.encode())
except KeyboardInterrupt:
    subprocess.run(["pkill", "-x", "say"])
    sys.exit(130)
