#!/usr/bin/env python3
"""read-aloud-ctl: PROTOTYPE (throwaway). Do not ship.

One CLI for every caller in the Read Aloud prototype:
  capture     Stop hook: write the Response to sessions/<id>/response.md
  expansion   UserPromptExpansion hook: handle stop/auto/status without a model turn
  response    Print the saved Response (injected into the forked skill)
  start       Begin a Reading (interrupt-and-replace), launch the detached player
  say         Queue one paragraph for the current Reading (arg --text or stdin)
  end         Mark the Reading complete
  stop        Stop the current Reading
  status      One-line status
  auto        auto on|off
  env         Print environment facts (probe)
  echo        Print stdin (probe)
  report      Timeline for the last Reading: time to first audio, stalls
  reset       Wipe the prototype state directory
  player      Internal: the detached player loop

State lives under ~/.claude/read-aloud-proto/ (PROTOTYPE, wipe me).
Every command appends a timestamped line to log.txt so the state is visible.
"""
import json
import os
import signal
import shutil
import subprocess
import sys
import time
import uuid

ROOT = os.path.expanduser(os.environ.get("RAP_ROOT", "~/.claude/read-aloud-proto"))
SESSIONS = os.path.join(ROOT, "sessions")
READINGS = os.path.join(ROOT, "readings")
LOG = os.path.join(ROOT, "log.txt")
CONFIG = os.path.join(ROOT, "config.json")
CURRENT = os.path.join(ROOT, "current")
SENTINEL = "Reading started."
DEFAULTS = {"auto": False, "threshold": 60, "voice": "", "rate": 190, "silent": False}
SELF = os.path.abspath(__file__)


def now():
    return time.time()


def stamp(t):
    return time.strftime("%H:%M:%S", time.localtime(t)) + ".%03d" % int((t % 1) * 1000)


def log(event, **kv):
    os.makedirs(ROOT, exist_ok=True)
    t = now()
    with open(LOG, "a") as f:
        f.write("%s %.3f %s %s\n" % (stamp(t), t, event, json.dumps(kv, ensure_ascii=False)))


def config():
    c = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            c.update(json.load(f))
    except FileNotFoundError:
        pass
    return c


def save_config(c):
    os.makedirs(ROOT, exist_ok=True)
    with open(CONFIG + ".tmp", "w") as f:
        json.dump(c, f, indent=2)
    os.replace(CONFIG + ".tmp", CONFIG)


def words(s):
    return len(s.split())


def arg(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def session_dir(sid):
    d = os.path.join(SESSIONS, sid or "unknown")
    os.makedirs(d, exist_ok=True)
    return d


def write_atomic(path, text):
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None


def env_facts():
    keys = ["CLAUDE_CODE_SESSION_ID", "CLAUDECODE", "CLAUDE_CODE_CHILD_SESSION",
            "CLAUDE_PLUGIN_ROOT", "CLAUDE_PLUGIN_DATA", "CLAUDE_PROJECT_DIR", "CLAUDE_CODE_ENTRYPOINT"]
    return {k: os.environ.get(k) for k in keys if os.environ.get(k) is not None}


def detach(argv, logfile):
    """Start argv fully detached: new session (setsid), no tty, stdio to a file."""
    with open(logfile, "ab") as out:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                             start_new_session=True, close_fds=True, cwd="/")
    return p.pid


def read_current():
    v = read_text(CURRENT)
    return v.strip() if v else None


def player_pid(rid):
    v = read_text(os.path.join(READINGS, rid, "player.pid"))
    try:
        return int(v.strip())
    except (AttributeError, ValueError):
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, TypeError):
        return False
    except PermissionError:
        return True


def kill_reading(rid, why):
    if not rid:
        return False
    d = os.path.join(READINGS, rid)
    os.makedirs(d, exist_ok=True)
    open(os.path.join(d, "STOP"), "w").close()
    pid = player_pid(rid)
    killed = False
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)  # player is a session leader, so pgid == pid; say dies with it
            killed = True
        except ProcessLookupError:
            pass
    log("kill", reading=rid, pid=pid, killed=killed, why=why)
    if read_current() == rid:
        os.remove(CURRENT)
    return killed


# ---------------------------------------------------------------- hooks

def cmd_capture(args):
    t0 = now()
    data = json.load(sys.stdin)
    sid = data.get("session_id", "")
    msg = data.get("last_assistant_message") or ""
    d = session_dir(sid)
    n = words(msg)
    c = config()
    is_sentinel = SENTINEL in msg and n <= 12
    verdict = "sentinel" if is_sentinel else ("short" if n < c["threshold"] else "readable")
    # Finding from probe 3: the relay turn's "Reading started." must not replace the Response,
    # or the next /read-aloud reads the sentinel aloud. Keep the last real Response.
    if not is_sentinel:
        write_atomic(os.path.join(d, "response.md"), msg)
    auto = "auto-would-fire" if (c["auto"] and verdict == "readable") else "auto-quiet"
    extra = {}
    if os.environ.get("RAP_PROBE_DETACH"):
        # Unsettled 4: does a detached child of a synchronous Stop hook outlive the hook and the session?
        sleeper = [sys.executable, "-c", "import time; time.sleep(900)"]
        setsid_pid = detach(sleeper, os.path.join(ROOT, "detach-probe.log"))
        plain = subprocess.Popen(sleeper, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, close_fds=True)
        extra = {"probe_setsid_pid": setsid_pid, "probe_plain_pid": plain.pid}
        write_atomic(os.path.join(ROOT, "detach-probe.json"), json.dumps(extra))
    keys = {k: (len(v) if isinstance(v, str) else v) for k, v in data.items() if k != "last_assistant_message"}
    write_atomic(os.path.join(d, "last-stop-input.json"), json.dumps(keys, indent=2))
    write_atomic(os.path.join(d, "captured-at"), "%.3f" % now())
    log("stop-hook", session=sid, words=n, verdict=verdict, auto=auto,
        stop_hook_active=data.get("stop_hook_active"), ms=round((now() - t0) * 1000),
        env_sid=os.environ.get("CLAUDE_CODE_SESSION_ID"), **extra)


def control(verb, rest):
    c = config()
    if verb == "stop":
        rid = read_current()
        killed = kill_reading(rid, "stop")
        return "Read aloud: stopped." if killed else "Read aloud: nothing is playing."
    if verb == "auto":
        if rest and rest[0] in ("on", "off"):
            c["auto"] = rest[0] == "on"
            save_config(c)
        return "Read aloud: auto mode %s." % ("on" if c["auto"] else "off")
    if verb == "status":
        rid = read_current()
        playing = "reading %s" % rid if rid and alive(player_pid(rid)) else "idle"
        return "Read aloud: %s; auto %s; voice %s." % (playing, "on" if c["auto"] else "off", c["voice"] or "default")
    return "Read aloud: unknown subcommand %r." % verb


def cmd_expansion(args):
    data = json.load(sys.stdin)
    sid = data.get("session_id", "")
    name = data.get("command_name", "") or ""
    cargs = (data.get("command_args") or "").strip()
    parts = cargs.split()
    verb = parts[0] if parts else ""
    log("expansion-hook", session=sid, command_name=name, command_args=cargs,
        command_source=data.get("command_source"), keys=sorted(data.keys()))
    if not name.endswith("read-aloud"):
        return
    if verb in ("stop", "auto", "status"):
        reason = control(verb, parts[1:])
        log("expansion-block", session=sid, verb=verb, reason=reason)
        print(json.dumps({"decision": "block", "reason": reason}))
        return
    # Plain /read-aloud: let it expand. Record T0 for time-to-first-audio.
    write_atomic(os.path.join(session_dir(sid), "t0"), "%.3f" % now())


# ---------------------------------------------------------------- skill-facing

def cmd_response(args):
    sid = arg(args, "--session", "")
    t = now()
    path = os.path.join(SESSIONS, sid, "response.md")
    msg = read_text(path)
    if msg is None:
        log("response-missing", session=sid, env_sid=os.environ.get("CLAUDE_CODE_SESSION_ID"))
        print("NO RESPONSE CAPTURED for session %s. The Stop hook has not written %s yet. "
              "Do not start a Reading; reply with exactly: Nothing to read." % (sid, path))
        return
    age = round(t - os.path.getmtime(path), 3)
    log("response", session=sid, words=words(msg), age_s=age, env_sid=os.environ.get("CLAUDE_CODE_SESSION_ID"))
    write_atomic(os.path.join(session_dir(sid), "t1"), "%.3f" % t)
    sys.stdout.write(msg)


def start_reading(sid):
    """Interrupt-and-replace: kill the current Reading, create a new one, launch its detached player."""
    old = read_current()
    if old:
        kill_reading(old, "replaced")
    rid = time.strftime("%H%M%S") + "-" + uuid.uuid4().hex[:4]
    d = os.path.join(READINGS, rid)
    os.makedirs(os.path.join(d, "queue"))
    write_atomic(os.path.join(d, "session"), sid)
    write_atomic(CURRENT, rid)
    pid = detach([SELF, "player", rid], os.path.join(d, "player.log"))
    write_atomic(os.path.join(d, "player.pid"), str(pid))
    log("start", session=sid, reading=rid, player_pid=pid, replaced=old,
        env_sid=os.environ.get("CLAUDE_CODE_SESSION_ID"))
    return rid


def cmd_start(args):
    print(start_reading(arg(args, "--session", "")))


def queue_count(q):
    return len([f for f in os.listdir(q) if f.endswith(".txt")])


def cmd_say(args):
    if "--new" in args:
        # Probe 2 finding: a separate start call costs one model round trip (~3 s). Fold it into the first say.
        rid = start_reading(arg(args, "--session", ""))
        print(rid)
    else:
        rid = arg(args, "--reading") or read_current()
    if not rid:
        print("no current reading; run start first")
        return 1
    text = arg(args, "--text")
    if text is None:
        text = sys.stdin.read()
    text = text.strip()
    if not text:
        print("empty paragraph ignored")
        return 0
    q = os.path.join(READINGS, rid, "queue")
    os.makedirs(q, exist_ok=True)
    n = queue_count(q) + 1
    write_atomic(os.path.join(q, "%03d.txt" % n), text)
    log("say", reading=rid, para=n, words=words(text))
    print("queued paragraph %d (%d words)" % (n, words(text)))


def cmd_end(args):
    rid = arg(args, "--reading") or read_current()
    if not rid:
        print("no current reading")
        return 1
    d = os.path.join(READINGS, rid)
    open(os.path.join(d, "END"), "w").close()
    n = queue_count(os.path.join(d, "queue"))
    log("end", reading=rid, paragraphs=n)
    print("reading %s complete: %d paragraphs queued" % (rid, n))


def cmd_stop(args):
    print(control("stop", []))


def cmd_status(args):
    print(control("status", []))


def cmd_auto(args):
    print(control("auto", args))


def cmd_env(args):
    label = arg(args, "--label", "")
    facts = env_facts()
    facts.update(label=label, pid=os.getpid(), ppid=os.getppid(), cwd=os.getcwd(),
                 stdin_tty=sys.stdin.isatty(), argv0=sys.argv[0])
    log("env", **facts)
    print(json.dumps(facts))


def cmd_echo(args):
    label = arg(args, "--label", "")
    text = sys.stdin.read()
    log("echo", label=label, chars=len(text), text=text[:80])
    print("echo %s: %r" % (label, text.strip()))


# ---------------------------------------------------------------- player

def cmd_player(args):
    rid = args[0]
    d = os.path.join(READINGS, rid)
    q = os.path.join(d, "queue")
    c = config()
    log("player-up", reading=rid, pid=os.getpid(), pgid=os.getpgrp(),
        session_leader=(os.getsid(0) == os.getpid()), silent=c["silent"])
    i = 1
    idle = 0.0
    while True:
        if os.path.exists(os.path.join(d, "STOP")) or read_current() != rid:
            log("player-exit", reading=rid, why="stopped", spoken=i - 1)
            return
        p = os.path.join(q, "%03d.txt" % i)
        if os.path.exists(p):
            text = read_text(p) or ""
            n = words(text)
            t = now()
            log("speak-begin", reading=rid, para=i, words=n)
            argv = ["say", "-r", str(c["rate"])]
            if c["voice"]:
                argv += ["-v", c["voice"]]
            if c["silent"]:
                argv += ["-o", os.path.join(d, "para-%03d.aiff" % i)]
            argv += ["-f", p]
            rc = subprocess.call(argv)
            if c["silent"]:
                # say -o synthesizes faster than real time; sleep the rest so timing and kills behave like playback
                est = n / (c["rate"] / 60.0)
                time.sleep(max(0.0, est - (now() - t)))
            log("speak-end", reading=rid, para=i, rc=rc, s=round(now() - t, 2))
            i += 1
            idle = 0.0
            continue
        if os.path.exists(os.path.join(d, "END")):
            log("player-exit", reading=rid, why="done", spoken=i - 1)
            if read_current() == rid:
                os.remove(CURRENT)
            return
        time.sleep(0.1)
        idle += 0.1
        if idle > 300:
            log("player-exit", reading=rid, why="idle-timeout", spoken=i - 1)
            return


# ---------------------------------------------------------------- report / reset

def parse_log():
    out = []
    for line in (read_text(LOG) or "").splitlines():
        try:
            _, t, event, rest = line.split(" ", 3)
            out.append((float(t), event, json.loads(rest)))
        except ValueError:
            continue
    return out


def cmd_report(args):
    rid = arg(args, "--reading") or read_current()
    ev = parse_log()
    if not rid:
        starts = [e for e in ev if e[1] == "start"]
        if not starts:
            print("no readings in the log")
            return 1
        rid = starts[-1][2]["reading"]
    start = next((e for e in ev if e[1] == "start" and e[2].get("reading") == rid), None)
    if not start:
        print("reading %s not in log" % rid)
        return 1
    sid = start[2].get("session")
    t_start = start[0]
    before = [e for e in ev if e[0] <= t_start and e[2].get("session") == sid]
    t0 = next((e[0] for e in reversed(before) if e[1] == "expansion-hook"), None)
    t1 = next((e[0] for e in reversed(before) if e[1] == "response"), None)
    base = t0 if t0 is not None else (t1 if t1 is not None else t_start)
    base_name = "T0 (/read-aloud typed)" if t0 is not None else ("T1 (Response injected)" if t1 is not None else "start")
    mine = [e for e in ev if e[2].get("reading") == rid]
    rows = []
    print("Reading %s for session %s. Offsets in seconds from %s." % (rid, sid, base_name))
    if t1 is not None:
        print("  %+7.2f  Response injected into the skill" % (t1 - base))
    print("  %+7.2f  start (player pid %s%s)" % (t_start - base, start[2].get("player_pid"),
          ", replaced " + start[2]["replaced"] if start[2].get("replaced") else ""))
    first_audio = None
    last_end = None
    for t, event, kv in mine:
        if event == "say":
            print("  %+7.2f  paragraph %d queued (%d words)" % (t - base, kv["para"], kv["words"]))
        elif event == "speak-begin":
            stall = ""
            if last_end is not None and t - last_end > 0.05:
                stall = "   <- speaker waited %.2fs for the writer" % (t - last_end)
            if first_audio is None:
                first_audio = t
                stall = "   <- FIRST AUDIO, %.2fs after %s" % (t - base, base_name.split(" ")[0])
            print("  %+7.2f  paragraph %d speaking (%d words)%s" % (t - base, kv["para"], kv["words"], stall))
        elif event == "speak-end":
            last_end = t
            print("  %+7.2f  paragraph %d finished (%.2fs)" % (t - base, kv["para"], kv["s"]))
        elif event == "end":
            print("  %+7.2f  writer finished: %d paragraphs" % (t - base, kv["paragraphs"]))
        elif event == "kill":
            print("  %+7.2f  killed (%s)" % (t - base, kv["why"]))
        elif event == "player-exit":
            print("  %+7.2f  player exit: %s after %d paragraphs" % (t - base, kv["why"], kv["spoken"]))
    if first_audio is None:
        print("  no audio started")


def cmd_reset(args):
    rid = read_current()
    if rid:
        kill_reading(rid, "reset")
    shutil.rmtree(ROOT, ignore_errors=True)
    print("wiped %s" % ROOT)


COMMANDS = {
    "capture": cmd_capture, "expansion": cmd_expansion, "response": cmd_response,
    "start": cmd_start, "say": cmd_say, "end": cmd_end, "stop": cmd_stop, "status": cmd_status,
    "auto": cmd_auto, "env": cmd_env, "echo": cmd_echo, "player": cmd_player,
    "report": cmd_report, "reset": cmd_reset,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        return 2
    return COMMANDS[sys.argv[1]](sys.argv[2:]) or 0


if __name__ == "__main__":
    sys.exit(main())
